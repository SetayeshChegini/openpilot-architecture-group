-- Run this only after inviting all five members in Supabase Authentication.
-- Replace every example email with the exact invited email address.
-- This file intentionally contains no real email addresses or credentials.

insert into public.profiles (user_id, member_id, display_name, role)
select id, 'setayesh-chegini', 'Setayesh Chegini', 'coordinator'
from auth.users where lower(email) = lower('SETAYESH_EMAIL@example.com')
on conflict (user_id) do update set member_id = excluded.member_id, display_name = excluded.display_name, role = excluded.role;

